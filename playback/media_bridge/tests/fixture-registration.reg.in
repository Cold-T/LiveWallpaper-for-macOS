Windows Registry Editor Version 5.00

; REVIEW TEMPLATE ONLY. engine_fixture.py writes a UTF-16 file with the private DLL path.
; Import solely into the explicit owned fixture prefix, never the normal runtime.
[HKEY_LOCAL_MACHINE\Software\Microsoft\WindowsRuntime\ActivatableClassId\Windows.Media.Control.GlobalSystemMediaTransportControlsSessionManager]
"DllPath"="@@PRIVATE_FIXTURE_DLL_WINDOWS_PATH_ESCAPED@@"

