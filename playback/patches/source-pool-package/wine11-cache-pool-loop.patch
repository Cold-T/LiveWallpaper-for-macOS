+/* One bounded output scratch allocation, leased until the wg_sample is destroyed.
+ * An outstanding lease never aliases a subsequent output. The owner and each
+ * lease hold refs, so processor destruction cannot free leased storage. */
+struct wg_output_cache
+{
+    LONG refcount;
+    BYTE *data;
+    DWORD capacity;
+    BOOL leased;
+    SRWLOCK lock;
+};
+
+void wg_output_cache_release(struct wg_output_cache *cache)
+{
+    if (!cache || InterlockedDecrement(&cache->refcount)) return;
+    free(cache->data);
+    free(cache);
+}
+
+static BYTE *wg_output_cache_acquire(struct wg_output_cache **owner, DWORD length,
+        struct wg_output_cache **lease, BOOL *hit)
+{
+    struct wg_output_cache *cache;
+    BYTE *data;
+    *lease = NULL;
+    *hit = FALSE;
+    if (!owner) return malloc(length);
+    cache = InterlockedCompareExchangePointer((void * volatile *)owner, NULL, NULL);
+    if (!cache)
+    {
+        struct wg_output_cache *existing;
+        if (!(cache = calloc(1, sizeof(*cache)))) return malloc(length);
+        cache->refcount = 1;
+        existing = InterlockedCompareExchangePointer((void * volatile *)owner, cache, NULL);
+        if (existing) { wg_output_cache_release(cache); cache = existing; }
+    }
+    AcquireSRWLockExclusive(&cache->lock);
+    if (cache->leased) { ReleaseSRWLockExclusive(&cache->lock); return malloc(length); }
+    if (cache->capacity < length)
+    {
+        if (!(data = malloc(length))) { ReleaseSRWLockExclusive(&cache->lock); return NULL; }
+        free(cache->data);
+        cache->data = data;
+        cache->capacity = length;
+    }
+    else *hit = TRUE;
+    cache->leased = TRUE;
+    InterlockedIncrement(&cache->refcount);
+    *lease = cache;
+    data = cache->data;
+    ReleaseSRWLockExclusive(&cache->lock);
+    return data;
+}
