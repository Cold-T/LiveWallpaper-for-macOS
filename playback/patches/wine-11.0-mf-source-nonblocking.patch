+/* No Unix buffer loan crosses calls: preflight is advisory; actual read/copy/
+ * release is atomic in Unix and epoch-checked against asynchronous Gst flush. */
+static HRESULT source_sample_pump(struct media_source *source, struct media_stream *stream)
+{
+    struct source_async_command *request = stream->request_head;
+    struct wg_parser_buffer meta;
+    enum wg_parser_read_status status;
+    IMFMediaBuffer *buffer = NULL;
+    IMFSample *sample = NULL;
+    UINT64 epoch = 0;
+    BYTE *data;
+    HRESULT hr = S_OK;
+
+    if (source->state != SOURCE_RUNNING || !stream->active || !request) return S_OK;
+    status = wg_parser_stream_try_read(source->wg_parser, stream->wg_stream, &epoch, &meta, NULL, 0);
+    if (status == WG_PARSER_READ_EOS)
+    {
+        hr = media_stream_send_eos(source, stream);
+        flush_token_queue(stream, FALSE);
+        return hr;
+    }
+    if (status == WG_PARSER_READ_WOULD_BLOCK || status == WG_PARSER_READ_CANCELLED)
+        return schedule_sample_retry(stream);
+    if (status != WG_PARSER_READ_NEED_BUFFER) return E_UNEXPECTED;
+    if (FAILED(hr = MFCreateMemoryBuffer(meta.size, &buffer))) return hr;
+    if (FAILED(hr = IMFMediaBuffer_Lock(buffer, &data, NULL, NULL))) goto out;
+    status = wg_parser_stream_try_read(source->wg_parser, stream->wg_stream, &epoch, &meta, data, meta.size);
+    IMFMediaBuffer_Unlock(buffer);
+    if (status != WG_PARSER_READ_READY)
+    {
+        if (status == WG_PARSER_READ_ERROR) hr = E_UNEXPECTED;
+        else hr = schedule_sample_retry(stream); /* never turn cancellation into EOS */
+        goto out;
+    }
+    if (FAILED(hr = IMFMediaBuffer_SetCurrentLength(buffer, meta.size))) goto out;
+    if (FAILED(hr = MFCreateSample(&sample))) goto out;
+    if (FAILED(hr = IMFSample_AddBuffer(sample, buffer))) goto out;
+    if (FAILED(hr = IMFSample_SetSampleTime(sample, meta.pts))) goto out;
+    if (FAILED(hr = IMFSample_SetSampleDuration(sample, meta.duration))) goto out;
+    if (request->u.request_sample.token && FAILED(hr = IMFSample_SetUnknown(sample,
+            &MFSampleExtension_Token, request->u.request_sample.token))) goto out;
+    hr = IMFMediaEventQueue_QueueEventParamUnk(stream->event_queue, MEMediaSample,
+            &GUID_NULL, S_OK, (IUnknown *)sample);
+    if (SUCCEEDED(hr))
