+        stream->request_head = request->next;
+        if (!stream->request_head) stream->request_tail = NULL;
+        IUnknown_Release(&request->IUnknown_iface);
+        hr = schedule_sample_pump(stream);
+    }
+ out:
+    if (sample) IMFSample_Release(sample);
+    if (buffer) IMFMediaBuffer_Release(buffer);
+    return hr;
